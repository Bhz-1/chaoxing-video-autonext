{
  "manifest_version": 3,
  "name": "视频自动连播 · 自动下一节",
  "version": "1.0.0",
  "description": "当前视频播完自动播放本页下一个视频；本页视频全部播完后自动切换到下一小节并开始播放。",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "视频自动连播",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "96"
}